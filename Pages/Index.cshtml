@page
@model IndexModel
@{
    ViewData["Title"] = "Research";
}

<div class="d-flex align-items-center mb-4 mt-3 flex-wrap gap-2">
    <h4 class="mb-0 fw-bold">
        <i class="bi bi-search text-primary me-2"></i>YouTube Research
    </h4>
    @if (!string.IsNullOrEmpty(Model.Session.CurrentNiche))
    {
        <span class="niche-badge ms-2">@Model.Session.CurrentNiche</span>
        <span class="text-muted small">@Model.Session.SearchResults.Count videos found</span>
    }
</div>

<!-- ── Search Form ──────────────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="post" asp-page-handler="Search" data-loading="Searching YouTube...">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-semibold small">Niche / Keywords</label>
                    <input type="text" name="niche" value="@Model.Session.CurrentNiche"
                           class="form-control"
                           placeholder="e.g. woodworking, AI tutorials, sourdough baking..." required />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Results</label>
                    <select name="maxResults" class="form-select">
                        @foreach (var n in new[] { 50, 100, 250, 500, 1000 })
                        {
                            <option value="@n" selected="@(n == Model.MaxResults)">@n videos</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Sort By</label>
                    <select name="rankBy" class="form-select">
                        <option value="views"      selected="@(Model.RankBy == "views")">View Count</option>
                        <option value="trending"   selected="@(Model.RankBy == "trending")">Date (Trending)</option>
                        <option value="engagement" selected="@(Model.RankBy == "engagement")">Engagement</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Search YouTube
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Session.SearchResults.Any())
{
    <!-- ── Action Buttons ──────────────────────────────────────────────────── -->
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <form method="post" asp-page-handler="Analyze" data-loading="Analyzing patterns...">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-bar-chart-line me-1"></i>Analyze Patterns
            </button>
        </form>
        <form method="post" asp-page-handler="Save" data-loading="Saving to database...">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-database-add me-1"></i>Save @Model.Session.SearchResults.Count Videos to DB
            </button>
        </form>
    </div>

    <!-- ── Results Table ───────────────────────────────────────────────────── -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width:42px">#</th>
                            <th style="width:76px">Thumb</th>
                            <th>Title</th>
                            <th>Channel</th>
                            <th class="text-end">Views</th>
                            <th class="text-end">Likes</th>
                            <th class="text-end">Engage%</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Session.SearchResults.Count; i++)
                        {
                            var v = Model.Session.SearchResults[i];
                            <tr>
                                <td class="ps-3 text-muted small">@(i + 1)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(v.ThumbnailUrl))
                                    {
                                        <a href="https://www.youtube.com/watch?v=@v.VideoId" target="_blank">
                                            <img src="@v.ThumbnailUrl" alt="" style="width:72px;border-radius:4px;" />
                                        </a>
                                    }
                                </td>
                                <td style="max-width:320px;">
                                    <a href="https://www.youtube.com/watch?v=@v.VideoId" target="_blank"
                                       class="text-decoration-none fw-semibold text-dark small lh-sm">
                                        @v.Title
                                    </a>
                                    <div class="text-muted" style="font-size:0.74rem;">
                                        @(v.PublishedAt.Length >= 10 ? v.PublishedAt[..10] : v.PublishedAt)
                                    </div>
                                </td>
                                <td class="text-muted small">@v.ChannelTitle</td>
                                <td class="text-end fw-semibold small">@v.ViewCount.ToString("N0")</td>
                                <td class="text-end text-muted small">@v.LikeCount.ToString("N0")</td>
                                <td class="text-end">
                                    <span class="badge rounded-pill @(v.EngagementRate > 5 ? "bg-success" : v.EngagementRate > 2 ? "bg-warning text-dark" : "bg-secondary")">
                                        @v.EngagementRate.ToString("F2")%
                                    </span>
                                </td>
                                <td class="text-muted small">@v.Duration</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-youtube display-1 text-muted opacity-50"></i>
        <h5 class="mt-3 text-muted">No results yet</h5>
        <p class="text-muted">Enter a niche above to search YouTube for top-performing videos.</p>
        <p class="text-muted small">Need API keys? Go to <a href="/Settings">Settings</a>.</p>
    </div>
}
